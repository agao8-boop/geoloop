# ============================================================
# GeoSite Advisor — .gitignore
#
# SECURITY: This project separates developer (private) data
# from public app code. Everything listed here stays off
# GitHub and off the deployed server. See
# docs/operations/two-track-system.md for the full policy.
# ============================================================

# ── DEVELOPER / RESEARCH DATA (your moat — never public) ────
data/research/
weekly_progress/
docs/decisions/
docs/references/
docs/superpowers/
notebooks/
scripts/

# ── SECRETS & ENVIRONMENT ────────────────────────────────────
.env
.env.*
*.pem
*.key
secrets/

# ── PYTHON ───────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# ── OS & EDITOR ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# ── WORKING DATA CACHES (developer only) ─────────────────────
# These pre-date the two-track structure; treat as research data
data/soil_cache/
data/weather/
data/idf_prototypes/

# ── LARGE DOWNLOADABLE SOURCE DATA ───────────────────────────
# DOE prototype IDFs: re-download from energycodes.gov
data/doe_prototypes/
# EPW weather files: re-download from climate.onebuilding.org
data/epw/
# CBECS raw survey data
data/cbecs/
# WSHP validation data
data/wshp_validation/

# ── GENERATED / COMPUTED DATA (reproduced by scripts) ────────
# EnergyPlus simulation work directories (large, reproducible)
data/energyplus_cache/
# Envelope study: exclude everything (results now excluded too)
data/envelope_study/
# Trained ML model artifacts
data/ml/
# ML county output (regenerated by ml/ pipeline)
data/public/ml_thermal_by_county.csv

# ── TEMP / DESIGN SCRATCH ────────────────────────────────────
DESIGN-IS-*/
data/overnight_summary.txt
*.log

# ── LARGE REFERENCE FILES ────────────────────────────────────
# Raw Excel/PDF reference materials stay local only
data/reference/*.xlsx
data/reference/*.xls
data/reference/*.pdf
docs/references/*.pdf

# ── PERSONAL / LOCAL-ONLY FILES ──────────────────────────────
interview_prep_intersect.md
.codebase-memory/
docs/methodology_revision_plan_jul28.md
certs/
