# GeoSite Advisor — Environment Variables Template
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is in .gitignore and must never be committed to git.
#
# For local development, the defaults below work without changes.
# For production deployment, set all values explicitly on the server.

# Flask
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-random-string-in-production

# EnergyPlus installation path (required for real-time simulation)
# macOS default: /Applications/EnergyPlus-24-2-0
# Linux default: /usr/local/EnergyPlus-24-2-0
ENERGYPLUS_DIR=

# Data paths (defaults work if you run flask from the project root)
# DATA_PUBLIC_DIR=data/public
# DATA_RESEARCH_DIR=data/research

# External API keys (added here as each data source is integrated)
# USGS_SDA_BASE_URL=https://sdmdataaccess.sc.egov.usda.gov/tabular/post.rest
# CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder
